{
  "name": "@bagooon/chatease-emdash-form",
  "version": "0.2.1",
  "description": "ChatEase contact forms for EmDash CMS",
  "type": "module",
  "license": "MIT",
  "author": "Hashimoto Giken",
  "engines": {
    "node": ">=22.23.4"
  },
  "files": [
    "dist",
    "src/astro",
    "src/model.ts",
    ".github/assets/chatease_logo.svg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": "./src/astro/index.ts"
  },
  "scripts": {
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit && astro check",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run check:package"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "astro": "^7.4.7",
    "emdash": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^11.1.11",
    "@astrojs/react": "^7.1.4",
    "@emdash-cms/blocks": "^1.4.0",
    "@types/node": "^22.19.0",
    "astro": "^7.4.7",
    "emdash": "1.4.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "miniflare": "5.20261101.0-beta",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "zod": "^4.6.6",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bagooon/emdash-chatease-contact-form.git"
  },
  "bugs": {
    "url": "https://github.com/bagooon/emdash-chatease-contact-form/issues"
  },
  "homepage": "https://chatease.jp/",
  "keywords": [
    "chatease",
    "emdash",
    "astro",
    "contact-form",
    "cloudflare-workers"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
